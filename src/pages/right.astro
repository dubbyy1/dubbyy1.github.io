---
// Settings: the screen to the right of home. Switches for the settings in scripts/settings.ts,
// and a button that resets the achievements. Everything is saved as soon as it's changed.
import "@fontsource-variable/fredoka/wght.css";
import Base from "../layouts/Base.astro";
import ScreenArrows from "../components/ScreenArrows.astro";

// One switch per setting, in order. `name` is the setting in scripts/settings.ts.
const switches = [
    {
        name: "animations",
        title: "Animations",
        description: "Pages sliding, blocks falling, things wiggling. Off keeps everything still.",
    },
    {
        name: "secrets",
        title: "Secrets",
        description: "The hand-drawn notes around the home page.",
    },
    {
        name: "physics",
        title: "Physics",
        description: "Projects falling into a pile. Off lines them up in rows.",
    },
];
---

<Base title="settings">
    <main>
        <h1>settings</h1>
        <ul class="settings">
            {
                switches.map(({ name, title, description }) => (
                    <li class="setting">
                        <div class="text">
                            <h2 id={`setting-${name}`}>{title}</h2>
                            <p id={`setting-${name}-about`}>{description}</p>
                        </div>
                        <button
                            class="switch"
                            type="button"
                            role="switch"
                            aria-checked="true"
                            aria-labelledby={`setting-${name}`}
                            aria-describedby={`setting-${name}-about`}
                            data-setting={name}
                        >
                            <span class="knob" />
                        </button>
                    </li>
                ))
            }
            <li class="setting">
                <div class="text">
                    <h2>Achievements</h2>
                    <p>Forget every achievement and start again from nothing.</p>
                </div>
                <button class="reset" type="button">Reset</button>
            </li>
        </ul>
        <script is:inline data-astro-rerun>
            // Each switch shows its setting before the page is drawn, so none flips over as it appears.
            // Reads the cookie scripts/settings.ts saves: keep the two in step.
            {
                let settings = {};
                try {
                    const cookie = document.cookie.split("; ").find((c) => c.startsWith("settings="));
                    if (cookie) settings = JSON.parse(decodeURIComponent(cookie.slice("settings=".length)));
                    else if (localStorage.getItem("drawings") === "off") settings.secrets = false;
                } catch {}
                for (const button of document.querySelectorAll(".switch")) {
                    button.setAttribute("aria-checked", String(settings[button.dataset.setting] !== false));
                }
            }
        </script>
    </main>
    <ScreenArrows />
</Base>

<script>
    import { getSettings, setSetting, type Settings } from "../scripts/settings";
    import { resetAchievements } from "../scripts/achievements";

    const CONFIRM_MS = 4000; // how long "Are you sure?" waits for the second click
    const DONE_MS = 2000; // how long "Done!" shows

    document.addEventListener("astro:page-load", () => {
        const page = document.querySelector(".settings");
        if (!page) return;

        for (const button of page.querySelectorAll<HTMLButtonElement>(".switch")) {
            const name = button.dataset.setting as keyof Settings;
            button.addEventListener("click", () => {
                const on = !getSettings()[name];
                setSetting(name, on);
                button.setAttribute("aria-checked", String(on));
            });
        }

        // Resetting can't be undone, so the first click only asks; a second one within a few seconds does it.
        const reset = page.querySelector<HTMLButtonElement>(".reset")!;
        let timer = 0;
        const back = () => {
            reset.textContent = "Reset";
            reset.classList.remove("confirm", "done");
        };
        reset.addEventListener("click", () => {
            clearTimeout(timer);
            if (reset.classList.contains("confirm")) {
                resetAchievements();
                reset.classList.replace("confirm", "done");
                reset.textContent = "Done!";
                timer = window.setTimeout(back, DONE_MS);
                return;
            }
            reset.classList.remove("done");
            reset.classList.add("confirm");
            reset.textContent = "Are you sure?";
            timer = window.setTimeout(back, CONFIRM_MS);
        });
    });
</script>

<style>
    main {
        min-height: 100dvh;
        display: grid;
        align-content: start;
        justify-items: center;
        gap: calc(36 * var(--px));
        padding: calc(66 * var(--px)) clamp(56px, 12vw, 160px) 64px;
    }

    h1 {
        margin: 0;
        font-family: "Fredoka Variable", var(--font-body);
        font-weight: 600;
        font-size: max(48px, calc(96 * var(--px)));
        line-height: 1;
        color: var(--orange);
    }

    .settings {
        width: min(640px, 100%);
        display: grid;
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* White and rounded like the about and achievements pages' cards. */
    .setting {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px 20px 16px 24px;
        border-radius: 22px;
        background: #fff;
    }

    .text {
        flex: 1;
        min-width: 0;
    }

    h2 {
        margin: 0;
        font-family: "Fredoka Variable", var(--font-body);
        font-weight: 600;
        font-size: 22px;
        line-height: 1.2;
        color: var(--orange);
    }

    p {
        margin: 3px 0 0;
        font-weight: 600;
        font-size: 16px;
        line-height: 1.35;
    }

    button {
        flex: none;
        border: 0;
        font: inherit;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    /* An on/off switch: the knob slides across, and the track turns orange when it's on. */
    .switch {
        position: relative;
        width: 56px;
        height: 32px;
        padding: 0;
        border-radius: 999px;
        background: #e3d4c5;
        transition: background-color 150ms ease;
    }

    .switch[aria-checked="true"] {
        background: var(--orange);
    }

    .knob {
        position: absolute;
        top: 4px;
        left: 4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 3px rgb(26 13 0 / 0.25);
        transition: translate 200ms cubic-bezier(0.23, 1, 0.32, 1); /* ease-out-quint */
    }

    .switch[aria-checked="true"] .knob {
        translate: 24px 0;
    }

    /* An orange pill like the site's other buttons; dark while it's asking to be sure. */
    .reset {
        min-width: 132px;
        padding: 9px 18px;
        border-radius: 999px;
        background: var(--orange);
        color: #fff;
        font-weight: 800;
        font-size: 16px;
        transition: background-color 120ms ease, scale 120ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .reset.confirm {
        background: var(--orange-dark);
    }

    @media (hover: hover) and (pointer: fine) {
        .reset:hover {
            background: var(--orange-dark);
        }
    }

    .switch:active,
    .reset:active {
        scale: 0.96;
    }

    @media (prefers-reduced-motion: reduce) {
        .switch,
        .knob,
        .reset {
            transition: none;
        }
    }

    /* Phones: the switch or button goes under the words, so the words get the width. */
    @media (max-width: 600px) {
        main {
            padding-inline: 16px;
        }

        .setting {
            flex-wrap: wrap;
            padding: 14px 16px 16px;
        }

        .text {
            flex-basis: 100%;
        }
    }
</style>
