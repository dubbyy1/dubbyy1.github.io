---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import SocialLinks from "../components/SocialLinks.astro";
import ScreenArrows from "../components/ScreenArrows.astro";
import { Image } from "astro:assets";
import drawingCentre from "../assets/home/center.png";
import drawingLeft from "../assets/home/left.png";
import drawingRight from "../assets/home/right.png";
import drawingCorner from "../assets/home/topright.png";
// What each drawing switches to when the secrets are hidden. The corner one has none: it just disappears.
import drawingCentreClean from "../assets/home/center-clean.png";
import drawingLeftClean from "../assets/home/left-clean.png";
import drawingRightClean from "../assets/home/right-clean.png";
// The toggle's icon while the drawings are showing, and while they're switched off. Swap the files to change them.
import secretsShownIcon from "../assets/home/secrets-shown.svg";
import secretsHiddenIcon from "../assets/home/secrets-hidden.svg";

import taglinesFile from "../data/taglines.txt?raw";

// The line under the logo is one of these, picked at random on every visit: src/data/taglines.txt,
// one tagline per line (blank lines are skipped). *Stars* around words make them bold.
const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const taglines = taglinesFile
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => escape(line).replace(/\*([^*]+)\*/g, "<b>$1</b>"));
---

<Base>
    {/* The secrets setting (scripts/settings.ts) picks which version of each drawing shows: with secrets, or clean.
        The button in the corner flips it, as does the settings page. */}
    <div class="home">
    {/* Hand-drawn notes, behind everything else. The side ones follow the arrows (--arrow-* in global.css). */}
    <div class="doodles" aria-hidden="true">
        <Image class="doodle left on" src={drawingLeft} alt="" loading="eager" />
        <Image class="doodle left off" src={drawingLeftClean} alt="" loading="eager" />
        <Image class="doodle right on" src={drawingRight} alt="" loading="eager" />
        <Image class="doodle right off" src={drawingRightClean} alt="" loading="eager" />
        <Image class="doodle corner on" src={drawingCorner} alt="" loading="eager" />
    </div>

    <main>
        <div class="hero">
            {/* Pointers to the projects (d) and about (u) pages, the colour and the y's outline: drawn around the logo. */}
            <Image class="doodle centre on" src={drawingCentre} alt="" loading="eager" />
            <Image class="doodle centre off" src={drawingCentreClean} alt="" loading="eager" />
            <h1><Logo /></h1>
            <p class="tagline">
                {
                    taglines.map((line, i) => (
                        <span hidden={i !== 0}>
                            <i set:html={line} />
                        </span>
                    ))
                }
            </p>
            <script is:inline data-astro-rerun>
                // Runs as soon as the tagline is parsed (and again on each visit), so the first line never flashes.
                // Clicking it switches to another line.
                {
                    const tagline = document.querySelector(".tagline");
                    const lines = tagline.children;
                    // Shows a random line other than the one numbered `not`, and remembers it.
                    // Never the same line twice in a row, so coming back (or clicking) always looks different.
                    const show = (not) => {
                        const hasLast = not >= 0 && not < lines.length;
                        let pick = Math.floor(Math.random() * (hasLast ? lines.length - 1 : lines.length));
                        if (hasLast && pick >= not) pick++;
                        try { sessionStorage.setItem("tagline", String(pick)); } catch {}
                        for (let i = 0; i < lines.length; i++) lines[i].hidden = i !== pick;
                        return pick;
                    };
                    let last = -1;
                    try { last = Number(sessionStorage.getItem("tagline") ?? -1); } catch {}
                    let current = show(last);

                    // A click rolls the tagline like a box turning a quarter: the old line tips back onto the
                    // top face as the new one comes up from the bottom face. The box is as tall as the old line
                    // and as deep as the new one (they can be one or two lines), so after the turn the new
                    // line is the front. Both faces turn about the box's middle, which moves from half the
                    // old height down to half the new height so the text stays lined up at the top.
                    // Still, if animations are off in the settings or the device asks for less motion.
                    const reduceMotion = () =>
                        document.documentElement.dataset.motion === "off" ||
                        matchMedia("(prefers-reduced-motion: reduce)").matches;
                    const TURN = { duration: 450, easing: "cubic-bezier(0.65, 0, 0.35, 1)" }; // ease-in-out-cubic
                    // A face whose own turning point is (y, z) from its top, turned by `angle` about the box's
                    // middle at (my, mz).
                    const face = (my, mz, angle, y, z) =>
                        `translate3d(0, ${my}px, ${mz}px) rotateX(${angle}deg) translate3d(0, ${-y}px, ${-z}px)`;
                    let stopRoll = () => {};
                    tagline.addEventListener("click", () => {
                        stopRoll();
                        const old = lines[current];
                        // The exact width: offsetWidth rounds to whole pixels, and a line rounded down even
                        // a fraction too narrow wraps onto a second line while it turns.
                        const { width: oldWidth, height: h } = old.getBoundingClientRect();
                        current = show(current);
                        if (reduceMotion()) return;
                        const next = lines[current];
                        const d = next.offsetHeight;

                        // The old line stays on screen over the new one until it has turned away.
                        old.hidden = false;
                        Object.assign(old.style, { position: "absolute", left: "0", top: "0", width: `${oldWidth}px` });
                        old.style.transformOrigin = next.style.transformOrigin = "0 0";
                        // Darker as it faces away, like a side of the box in shadow.
                        const turns = [
                            old.animate(
                                [
                                    { transform: face(h / 2, -d / 2, 0, h / 2, -d / 2) },
                                    { transform: face(d / 2, -h / 2, 90, h / 2, -d / 2), opacity: 0.3 },
                                ],
                                TURN,
                            ),
                            next.animate(
                                [
                                    { transform: face(h / 2, -d / 2, -90, d / 2, -h / 2), opacity: 0.3 },
                                    { transform: face(d / 2, -h / 2, 0, d / 2, -h / 2) },
                                ],
                                TURN,
                            ),
                        ];
                        const done = () => {
                            turns.forEach((turn) => turn.cancel());
                            old.hidden = true;
                            old.removeAttribute("style");
                            next.removeAttribute("style");
                            stopRoll = () => {};
                        };
                        stopRoll = done;
                        turns[0].finished.then(done, () => {});
                    });
                }
            </script>
            <div class="socials">
                <SocialLinks />
            </div>
        </div>
    </main>
    <ScreenArrows />

    <button class="drawings-toggle" type="button" aria-pressed="false">
        <Image class="icon on" src={secretsShownIcon} alt="" loading="eager" />
        <Image class="icon off" src={secretsHiddenIcon} alt="" loading="eager" />
        {/* Not shown, but still read out by screen readers. */}
        <span class="label visually-hidden">hide secrets</span>
    </button>
    </div>
</Base>

<script>
    import { getSettings, setSetting } from "../scripts/settings";

    document.addEventListener("astro:page-load", () => {
        const button = document.querySelector<HTMLButtonElement>(".drawings-toggle");
        if (!button) return;
        const show = (secrets: boolean) => {
            // Pressed means the secrets are hidden.
            button.setAttribute("aria-pressed", String(!secrets));
            button.querySelector(".label")!.textContent = secrets ? "hide secrets" : "show secrets";
        };
        show(getSettings().secrets);
        button.addEventListener("click", () => {
            const secrets = !getSettings().secrets;
            setSetting("secrets", secrets);
            show(secrets);
        });
    });
</script>

<style>
    /* Only a wrapper; it doesn't take part in the layout. */
    .home {
        display: contents;
    }

    /* Each drawing and the toggle's icon come in two versions: with the secrets (.on) and without (.off).
       <html data-secrets="off"> (scripts/settings.ts) says which. */
    :global(html:not([data-secrets="off"])) .home :is(.doodle, .icon).off,
    :global(html[data-secrets="off"]) .home :is(.doodle, .icon).on {
        display: none;
    }

    /* Top left, opposite the corner drawing. */
    .drawings-toggle {
        position: fixed;
        left: clamp(8px, 1.354vw, 30px);
        top: clamp(8px, 1.354vw, 30px);
        padding: 6px;
        border: none;
        background: none;
        cursor: pointer;
        transition: scale 0.2s;
    }

    .drawings-toggle .icon {
        width: max(28px, calc(36 * var(--px)));
        height: max(28px, calc(36 * var(--px)));
    }

    .drawings-toggle:hover {
        scale: 1.08;
    }

    main {
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 24px clamp(56px, 12vw, 160px);
    }

    /* Everything in the hero is positioned in the logo's own units (it's 599 wide in the design),
       so the whole group scales together. */
    .hero {
        container-type: inline-size;
        position: relative;
        /* 599 px on a 1920-wide screen and the same share of any other (--px in global.css). */
        width: min(calc(599 * var(--px)), 100%);
        /* Logo plus the icons that hang below it. */
        aspect-ratio: 599 / 247;
        /* The design sits the group slightly below centre. */
        translate: 0 3.6%;
    }

    .hero > * {
        --u: calc(100cqw / 599);
    }

    h1 {
        margin: 0;
    }

    .tagline {
        position: absolute;
        left: calc(6 * var(--u));
        top: calc(147 * var(--u));
        margin: 0;
        font-size: calc(24 * var(--u));
        font-weight: 500;
        color: hsl(30 90% 20%);
        /* Long lines wrap before they reach the dropped y (the design's 410-wide text box). */
        max-width: calc(410 * var(--u));
        line-height: 1.3;
        /* Clicking it rolls to another line (see the script after it), so quick clicks shouldn't select it. */
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        /* Depth for the roll: lower is a stronger 3D look. */
        perspective: calc(600 * var(--u));
    }

    /* Blocks, so they can turn in 3D (inline text can't). */
    .tagline > span {
        display: block;
    }

    .tagline > span[hidden] {
        display: none;
    }

    /* :global because the taglines are put in as HTML, outside this page's scoped styles. */
    .tagline :global(b) {
        /* Not 800: Nunito drops the IPA length mark (ː) from 800 up. */
        font-weight: 780;
    }

    .socials {
        position: absolute;
        left: calc(266 * var(--u));
        top: calc(187 * var(--u));
        --social-size: calc(60 * var(--u));
        --social-gap: calc(26.5 * var(--u));
    }

    /* Hand-drawn notes. Measured from the full mockup (a 1600×1000 screen):
       the centre one in logo units, the side ones in arrow sizes from their arrow's centre. */
    .doodle {
        position: absolute;
        height: auto;
        pointer-events: none;
        user-select: none;
    }

    /* In the hero's own layer, under the logo, tagline and icons. */
    .centre {
        left: calc(-42.1 * var(--u));
        top: calc(-257 * var(--u));
        width: calc(690.9 * var(--u));
        z-index: -1;
    }

    .doodles .doodle {
        position: fixed;
    }

    .left {
        left: calc(var(--arrow-inset) + var(--arrow-size) * (0.5 + 0.519));
        top: calc(var(--arrow-top) - var(--arrow-size) * 0.476);
        width: calc(var(--arrow-size) * 1.227);
    }

    .right {
        right: calc(var(--arrow-inset) + var(--arrow-size) * (0.5 - 0.795));
        top: calc(var(--arrow-top) - var(--arrow-size) * 1.204);
        width: calc(var(--arrow-size) * 1.612);
    }

    /* From the mockup: 330 of 3840 wide, 52 in from the top and right. */
    .corner {
        top: clamp(8px, 1.354vw, 30px);
        right: clamp(8px, 1.354vw, 30px);
        width: clamp(74px, 8.59vw, 193px);
    }

    /* Narrower screens: the logo fills the space beside the left arrow, so its label goes underneath. */
    @media (max-width: 1130px) {
        .left {
            left: calc(var(--arrow-inset) + 4px);
            top: calc(var(--arrow-top) + var(--arrow-size) * 0.6);
        }
    }

    /* Phones: the arrows hug the edges, so the labels sit under / over them instead of beside. */
    @media (max-width: 600px) {
        .left {
            left: 6px;
            top: calc(var(--arrow-top) + 50px);
            width: 62px;
        }

        .right {
            right: 6px;
            top: auto;
            bottom: calc(100% - var(--arrow-top) + 26px);
            width: 82px;
        }
    }
</style>
