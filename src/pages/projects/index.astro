---
// Projects: every project falls in as a block (components/ProjectPile.astro).
// Projects live in src/content/projects, one Markdown file each.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ProjectPile from "../../components/ProjectPile.astro";

const projects = (await getCollection("projects")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="projects">
    <SectionHeader page="projects" />
    <main>
        <h1 class="visually-hidden">Projects</h1>
        <ProjectPile projects={projects} />
    </main>
</Base>

<style>
    main {
        min-height: 100dvh;
    }
</style>
