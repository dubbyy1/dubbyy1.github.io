---
// One project's page, built from its file in src/content/projects (front matter + write-up).
import "@fontsource/tiro-bangla/400.css";
import "@fontsource/poppins/500.css";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { tagColour, tagText } from "../../data/tags";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hasBody = project.body?.trim().length;
const date = data.date.toISOString().slice(0, 10);

---

<Base title={data.title} description={data.description}>
    <SectionHeader fixed={false} />

    <main>
        <header class="intro">
            <h1>
                {data.title}
                {
                    data.github && (
                        <a class="github" href={data.github} target="_blank" rel="noopener noreferrer" aria-label={`${data.title} on GitHub`}>
                            <svg viewBox="0 0 98 96" aria-hidden="true">
                                <path d="M48.9 0C21.9 0 0 22 0 49.1c0 21.7 14 40.1 33.5 46.6 2.4.4 3.3-1.1 3.3-2.4v-8.4c-13.6 3-16.5-6.6-16.5-6.6-2.2-5.7-5.4-7.2-5.4-7.2-4.5-3 .3-3 .3-3 4.9.3 7.5 5.1 7.5 5.1 4.4 7.5 11.5 5.3 14.3 4.1.4-3.2 1.7-5.3 3.1-6.6-10.9-1.2-22.3-5.5-22.3-24.3 0-5.4 1.9-9.8 5-13.2-.5-1.2-2.2-6.2.5-13 0 0 4.1-1.3 13.4 5 3.9-1.1 8-1.6 12.2-1.6s8.3.5 12.2 1.6c9.3-6.3 13.4-5 13.4-5 2.7 6.8 1 11.8.5 13 3.1 3.4 5 7.8 5 13.2 0 18.9-11.5 23.1-22.4 24.3 1.8 1.5 3.3 4.5 3.3 9.1v13.5c0 1.3.9 2.8 3.4 2.4C83.9 89.1 98 70.7 98 49.1 98 22 76.1 0 48.9 0Z" />
                            </svg>
                        </a>
                    )
                }
            </h1>
            <p class="subtitle">{data.subtitle ?? data.description}</p>

            {
                data.links.length > 0 && (
                    <p class="try">
                        {data.try && <span>{data.try}</span>}
                        {data.links.map((link) => (
                            <a href={link.url} target="_blank" rel="noopener noreferrer">
                                {link.label}
                            </a>
                        ))}
                    </p>
                )
            }
        </header>

        {
            data.hero && (
                <figure class="hero">
                    {data.hero.video ? (
                        <video src={data.hero.video} poster={data.hero.poster} autoplay muted loop playsinline aria-label={data.hero.alt} />
                    ) : (
                        data.hero.image && <img src={data.hero.image} alt={data.hero.alt} />
                    )}
                </figure>
            )
        }

        <div class="meta">
            <ul class="tags">
                {data.tags.map((tag) => <li style={`background: ${tagColour(tag)}; color: ${tagText}`}>#{tag}</li>)}
            </ul>
            <p class="byline">Dubby Uzoukwu - <time datetime={date}>{date}</time></p>
        </div>

        <article class="writeup">
            {hasBody ? <Content /> : <p class="empty">More about this one soon.</p>}
        </article>
    </main>
</Base>

<style>
    /* Layout and type follow the "individual project" frame in Figma: a 672px column,
       Tiro Bangla for headings, Nunito for text. */
    main {
        --column: min(672px, 100% - 32px);
        --serif: "Tiro Bangla", Georgia, serif;
        padding: 48px 0 clamp(48px, 10vh, 120px);
    }

    /* Narrow screens: start below the corner logo instead of beside it. */
    @media (max-width: 900px) {
        main {
            padding-top: 88px;
        }
    }

    .intro,
    .hero,
    .meta,
    .writeup {
        width: var(--column);
        margin-inline: auto;
    }

    .intro {
        text-align: center;
    }

    h1 {
        margin: 0;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(38px, 5vw, 64px);
        line-height: 1.15;
        text-wrap: balance;
    }

    .github {
        display: inline-block;
        width: 0.5em;
        margin-left: 0.15em;
        vertical-align: 0.05em;
        color: #4e4e4e;
        transition: color 0.15s ease;
    }

    .github svg {
        width: 100%;
        fill: currentColor;
    }

    .github:hover {
        color: var(--ink);
    }

    .subtitle {
        max-width: 674px;
        margin: 0.5em auto 0;
        font-family: var(--serif);
        font-size: clamp(17px, 1.6vw, 20px);
        line-height: 1.3;
        text-wrap: balance;
    }

    .try {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px 10px;
        margin: 18px 0 0;
        font-weight: 500;
        font-size: 15px;
    }

    .try a {
        padding: 4px 15px;
        border-radius: 999px;
        background: var(--orange);
        color: #fff;
        text-decoration: none;
        transition: translate 0.15s ease;
    }

    .try a:hover {
        translate: 0 -2px;
    }

    .hero {
        margin-top: 32px;
        margin-bottom: 0;
    }

    /* Fills the column, but no taller than the space the design gives it. */
    .hero video,
    .hero img {
        display: block;
        width: auto;
        max-width: 100%;
        max-height: min(60vh, 440px);
        margin-inline: auto;
        border-radius: 6px;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 8px 16px;
        margin-top: 40px;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tags li {
        padding: 0 9px;
        border: 1px solid #11111b;
        border-radius: 10px;
        font-family: "Poppins", var(--font-body);
        font-weight: 500;
        font-size: 14px;
        line-height: 18px;
    }

    .byline {
        margin: 0 0 0 auto;
        font-weight: 500;
        font-size: 14px;
    }

    /* The write-up itself (Markdown/HTML from the content file). */
    .writeup {
        font-size: clamp(17px, 1.6vw, 20px);
        line-height: 1.45;
    }

    .writeup :global(h2) {
        margin: 1.1em 0 0.3em;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(34px, 3.8vw, 48px);
        line-height: 1.15;
    }

    .writeup :global(h3) {
        margin: 1.3em 0 0.3em 11px;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(24px, 2.4vw, 30px);
        line-height: 1.2;
    }

    .writeup :global(p) {
        margin: 0 0 1em;
        padding-left: 11px;
        text-indent: 0.75em;
    }

    .writeup :global(a) {
        color: var(--orange-dark);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 2px;
    }

    .writeup :global(code) {
        padding: 0.05em 0.3em;
        border-radius: 4px;
        background: hsl(30 60% 22% / 0.1);
        font-size: 0.88em;
    }

    .writeup :global(figure) {
        margin: 1.4em 0;
        text-align: center;
    }

    .writeup :global(figure img),
    .writeup :global(figure video) {
        display: inline-block;
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }

    .writeup :global(figcaption) {
        margin-top: 0.3em;
        font-style: italic;
        font-weight: 500;
        font-size: 16px;
    }

    .writeup :global(table) {
        width: calc(100% - 11px);
        margin: 0 0 1.2em 11px;
        border-collapse: collapse;
        font-size: 0.85em;
        line-height: 1.35;
    }

    .writeup :global(th),
    .writeup :global(td) {
        padding: 6px 10px;
        border: 2px solid #262626;
        text-align: left;
        vertical-align: top;
    }

    .writeup :global(thead tr:first-child th) {
        background: var(--orange);
        font-family: ui-monospace, monospace;
        font-weight: 600;
    }

    .writeup :global(thead tr + tr th) {
        background: hsl(30 100% 85%);
    }

    .writeup :global(td:first-child) {
        font-family: ui-monospace, monospace;
        font-size: 0.92em;
        white-space: nowrap;
    }

    .writeup .empty {
        margin-top: 2em;
        text-align: center;
        text-indent: 0;
        font-style: italic;
    }

    @media (max-width: 600px) {
        .writeup :global(table) {
            display: block;
            overflow-x: auto;
        }
    }
</style>
