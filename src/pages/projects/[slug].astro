---
// One project's page, built from its file in src/content/projects (front matter + write-up).
// Made for a short write-up (a paragraph or so): the picture beside the title, summary and text.
// A longer write-up moves to its own column underneath, so it still reads well.
import "@fontsource-variable/fredoka/wght.css";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { tagColour, tagText } from "../../data/tags";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    const all = projects.map((project) => project.id);
    return projects.map((project) => ({ params: { slug: project.id }, props: { project, all } }));
}

interface Props {
    project: CollectionEntry<"projects">;
    // Every project's id, for the "visit every project" achievement.
    all: string[];
}

const { project, all } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Words in the write-up, without any HTML tags in it. Past about a paragraph it gets its own column.
const words = (project.body ?? "").replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length;
const hasBody = words > 0;
const long = words > 150;

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const date = data.date.toISOString().slice(0, 10);
const shownDate = `${data.date.getUTCDate()} ${MONTHS[data.date.getUTCMonth()]} ${data.date.getUTCFullYear()}`;

// The picture: the demo video or image if there is one, otherwise the picture from the projects pile.
const pileImage = data.block.image;
const hasMedia = !!(data.hero?.video || data.hero?.image || pileImage);

// The < arrow: the same L shape as the screen arrows (components/ScreenArrows.astro), rotated.
const arrow =
    "M0 62.468V4C0 1.79086 1.79086 0 4 0H21.4558C23.665 0 25.4558 1.79086 25.4558 4V35.8808C25.4558 38.09 27.2467 39.8808 29.4559 39.8808H59.6396C61.8488 39.8808 63.6396 41.6717 63.6396 43.8808V62.468C63.6396 64.6772 61.8488 66.468 59.6396 66.468H4C1.79086 66.468 0 64.6772 0 62.468Z";
---

<Base title={data.title} description={data.description}>
    <SectionHeader page="projects" fixed={false} />

    <main>
        <div class:list={["project", { "no-media": !hasMedia }]} data-project={project.id} data-all-projects={JSON.stringify(all)}>
            <a class="back" href="/projects">
                <svg viewBox="0 0 63.6396 66.468" aria-hidden="true"><path d={arrow} /></svg>
                projects
            </a>

            {
                hasMedia && (
                    <figure class="media">
                        {data.hero?.video ? (
                            <video src={data.hero.video} poster={data.hero.poster} autoplay muted loop playsinline aria-label={data.hero.alt} />
                        ) : data.hero?.image ? (
                            <img src={data.hero.image} alt={data.hero.alt} />
                        ) : pileImage && pileImage.format === "gif" ? (
                            // GIFs are left as they are so they keep moving.
                            <img src={pileImage.src} width={pileImage.width} height={pileImage.height} alt="" />
                        ) : (
                            pileImage && <Image src={pileImage} alt="" width={960} loading="eager" />
                        )}
                    </figure>
                )
            }

            <div class="info">
                <h1>{data.title}</h1>

                <ul class="meta">
                    <li class="date"><time datetime={date}>{shownDate}</time></li>
                    {data.tags.map((tag) => <li class="tag" style={`background: ${tagColour(tag)}; color: ${tagText}`}>#{tag}</li>)}
                </ul>

                <p class="summary">{data.subtitle ?? data.description}</p>

                {
                    hasBody && !long && (
                        <div class="writeup">
                            <Content />
                        </div>
                    )
                }

                {
                    (data.github || data.links.length > 0) && (
                        <div class="actions">
                            {data.try && <p class="try">{data.try}</p>}
                            {data.links.map((link) => (
                                <a class="button" href={link.url} target="_blank" rel="noopener noreferrer">
                                    {link.label}
                                </a>
                            ))}
                            {data.github && (
                                <a class="button github" href={data.github} target="_blank" rel="noopener noreferrer">
                                    <svg viewBox="0 0 98 96" aria-hidden="true">
                                        <path d="M48.9 0C21.9 0 0 22 0 49.1c0 21.7 14 40.1 33.5 46.6 2.4.4 3.3-1.1 3.3-2.4v-8.4c-13.6 3-16.5-6.6-16.5-6.6-2.2-5.7-5.4-7.2-5.4-7.2-4.5-3 .3-3 .3-3 4.9.3 7.5 5.1 7.5 5.1 4.4 7.5 11.5 5.3 14.3 4.1.4-3.2 1.7-5.3 3.1-6.6-10.9-1.2-22.3-5.5-22.3-24.3 0-5.4 1.9-9.8 5-13.2-.5-1.2-2.2-6.2.5-13 0 0 4.1-1.3 13.4 5 3.9-1.1 8-1.6 12.2-1.6s8.3.5 12.2 1.6c9.3-6.3 13.4-5 13.4-5 2.7 6.8 1 11.8.5 13 3.1 3.4 5 7.8 5 13.2 0 18.9-11.5 23.1-22.4 24.3 1.8 1.5 3.3 4.5 3.3 9.1v13.5c0 1.3.9 2.8 3.4 2.4C83.9 89.1 98 70.7 98 49.1 98 22 76.1 0 48.9 0Z" />
                                    </svg>
                                    GitHub
                                </a>
                            )}
                        </div>
                    )
                }
            </div>
        </div>

        {
            long && (
                <article class="writeup long">
                    <Content />
                </article>
            )
        }
    </main>
</Base>

<script>
    import { collect } from "../../scripts/achievements";

    // Ticks this project off towards the "visit every project" achievement.
    document.addEventListener("astro:page-load", () => {
        const page = document.querySelector<HTMLElement>("[data-project]");
        if (!page) return;
        collect("all-projects", page.dataset.project!, JSON.parse(page.dataset.allProjects!));
    });
</script>

<style>
    main {
        --fredoka: "Fredoka Variable", var(--font-body);
        min-height: 100dvh;
        display: grid;
        align-content: center;
        justify-items: center;
        gap: 64px;
        padding: 96px 16px 64px;
    }

    /* The picture on the left, everything else beside it; the back link sits over both. */
    .project {
        width: min(1040px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        grid-template-areas:
            "back back"
            "media info";
        align-items: center;
        gap: 20px clamp(32px, 4vw, 56px);
    }

    .project.no-media {
        width: min(640px, 100%);
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
            "back"
            "info";
    }

    /* Back to the pile: a white pill with the screen arrows' chevron. */
    .back {
        grid-area: back;
        justify-self: start;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px 6px 12px;
        border-radius: 999px;
        background: #fff;
        color: var(--orange);
        font-weight: 800;
        font-size: 16px;
        text-decoration: none;
        transition: color 120ms ease, translate 150ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .back svg {
        width: 11px;
        rotate: 45deg;
        fill: currentColor;
    }

    @media (hover: hover) and (pointer: fine) {
        .back:hover {
            color: var(--orange-dark);
            translate: -3px 0;
        }
    }

    .back:active {
        scale: 0.96;
    }

    /* Outlined and rounded like the pictures on the about page. */
    .media {
        grid-area: media;
        margin: 0;
        overflow: hidden;
        border: 3px solid var(--orange-dark);
        border-radius: 20px;
        background: #fff;
    }

    .media video,
    .media img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 70vh;
        object-fit: contain;
    }

    .info {
        grid-area: info;
        min-width: 0;
    }

    h1 {
        margin: 0;
        font-family: var(--fredoka);
        font-weight: 700;
        font-size: clamp(36px, 4.4vw, 56px);
        line-height: 1.05;
        color: var(--orange);
        text-wrap: balance;
    }

    /* The date (a white card like the timeline's) and the tags, in their colours. */
    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 16px 0 0;
        padding: 0;
        list-style: none;
    }

    .meta li {
        padding: 3px 12px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 14px;
        line-height: 1.3;
    }

    .date {
        background: #fff;
        color: var(--orange);
    }

    .summary {
        margin: 20px 0 0;
        font-weight: 700;
        font-size: clamp(18px, 1.7vw, 21px);
        line-height: 1.35;
        text-wrap: pretty;
    }

    .writeup {
        margin-top: 14px;
        font-weight: 500;
        font-size: 17px;
        line-height: 1.55;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
    }

    .try {
        flex-basis: 100%;
        margin: 0;
        font-weight: 600;
        font-size: 15px;
    }

    .button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 999px;
        background: var(--orange);
        color: #fff;
        font-weight: 800;
        font-size: 16px;
        text-decoration: none;
        transition: background-color 120ms ease, scale 120ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .button.github {
        background: #1e1e2e;
    }

    .button svg {
        width: 18px;
        fill: currentColor;
    }

    @media (hover: hover) and (pointer: fine) {
        .button:hover {
            background: var(--orange-dark);
        }

        .button.github:hover {
            background: #313244;
        }
    }

    .button:active {
        scale: 0.96;
    }

    /* The write-up's Markdown. It's rendered outside this page's styles, hence :global. */
    .writeup > :global(*:first-child) {
        margin-top: 0;
    }

    .writeup :global(p) {
        margin: 0 0 0.9em;
    }

    .writeup :global(p:last-child) {
        margin-bottom: 0;
    }

    .writeup :global(a) {
        color: var(--orange-dark);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 2px;
    }

    .writeup :global(code) {
        padding: 0.05em 0.3em;
        border-radius: 4px;
        background: hsl(30 60% 22% / 0.1);
        font-size: 0.88em;
    }

    /* A longer write-up: its own column under the project, with headings, pictures and tables. */
    .writeup.long {
        width: min(672px, 100%);
        margin: 0;
        font-size: 18px;
    }

    .writeup :global(h2) {
        margin: 1.4em 0 0.4em;
        font-family: var(--fredoka);
        font-weight: 700;
        font-size: 32px;
        line-height: 1.15;
        color: var(--orange);
    }

    .writeup :global(h3) {
        margin: 1.2em 0 0.3em;
        font-family: var(--fredoka);
        font-weight: 600;
        font-size: 23px;
        line-height: 1.2;
        color: var(--orange-dark);
    }

    .writeup :global(figure) {
        margin: 1.4em 0;
        text-align: center;
    }

    .writeup :global(figure img),
    .writeup :global(figure video) {
        display: inline-block;
        max-width: 100%;
        height: auto;
        border: 3px solid var(--orange-dark);
        border-radius: 16px;
    }

    .writeup :global(figcaption) {
        margin-top: 0.3em;
        font-style: italic;
        font-weight: 500;
        font-size: 16px;
    }

    .writeup :global(table) {
        width: 100%;
        margin: 0 0 1.2em;
        border-collapse: collapse;
        font-size: 0.85em;
        line-height: 1.35;
    }

    .writeup :global(th),
    .writeup :global(td) {
        padding: 6px 10px;
        border: 2px solid #262626;
        text-align: left;
        vertical-align: top;
    }

    .writeup :global(thead tr:first-child th) {
        background: var(--orange);
        font-family: ui-monospace, monospace;
        font-weight: 600;
    }

    .writeup :global(thead tr + tr th) {
        background: hsl(30 100% 85%);
    }

    .writeup :global(td:first-child) {
        font-family: ui-monospace, monospace;
        font-size: 0.92em;
        white-space: nowrap;
    }

    /* Narrow screens: the picture on top, everything under it. */
    @media (max-width: 820px) {
        main {
            align-content: start;
            gap: 48px;
            padding-top: 88px;
        }

        .project {
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "back"
                "media"
                "info";
            gap: 20px;
        }

        .writeup :global(table) {
            display: block;
            overflow-x: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .back,
        .button {
            transition: none;
        }
    }
</style>
