---
// LinkedIn, GitHub and email icons.
import { Image } from "astro:assets";
import linkedin from "../assets/social/linkedin.png";
import github from "../assets/social/github.png";
---

<ul class="social-links">
    <li>
        <a href="https://www.linkedin.com/in/dubbyy/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <Image src={linkedin} alt="" width={120} height={120} />
        </a>
    </li>
    <li>
        <a href="https://github.com/dubbyy1" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <Image src={github} alt="" width={120} height={120} />
        </a>
    </li>
    <li>
        <a href="mailto:chidubem.d.uzoukwu@gmail.com" aria-label="Email">
            <svg viewBox="52 31 88 88" aria-hidden="true">
                <path fill="#4285f4" d="M58 108h14V74L52 59v43c0 3.32 2.69 6 6 6" />
                <path fill="#34a853" d="M120 108h14c3.32 0 6-2.69 6-6V59l-20 15" />
                <path fill="#fbbc04" d="M120 48v26l20-15v-8c0-7.42-8.47-11.65-14.4-7.2" />
                <path fill="#ea4335" d="M72 74V48l24 18 24-18v26L96 92" />
                <path fill="#c5221f" d="M52 51v8l20 15V48l-5.6-4.2c-5.94-4.45-14.4-.22-14.4 7.2" />
            </svg>
        </a>
    </li>
</ul>

<style>
    .social-links {
        display: flex;
        gap: var(--social-gap, 26px);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    a {
        display: block;
        width: var(--social-size, 60px);
        transition: translate 0.2s, rotate 0.2s;
    }

    a:hover {
        translate: 0 -4px;
        rotate: -6deg;
    }

    img,
    svg {
        width: 100%;
        height: auto;
    }
</style>
