---
// One card at a time from data/why.ts, with a button that deals another at random. Cards come from a
// shuffled deck, so every card shows once before any repeat, and never the same one twice in a row.
import { Image } from "astro:assets";
import { cards } from "../data/why";
import { caption } from "../utils/caption";
---

<div class="why-cards">
    {
        cards.length > 1 && (
            <button class="another" type="button">
                {/* Two arrows crossing: shuffle. */}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 7h3.5c2 0 3.2 1 4.3 2.6l2.4 4.8c1.1 1.6 2.3 2.6 4.3 2.6H21" />
                    <path d="M3 17h3.5c1.4 0 2.4-.5 3.2-1.3M14.3 8.3c.8-.8 1.8-1.3 3.2-1.3H21" />
                    <path d="M18 4l3 3-3 3M18 14l3 3-3 3" />
                </svg>
                random
            </button>
        )
    }
    <div class="deck" aria-live="polite">
        {
            cards.map((card, i) => (
                <article class="card" hidden={i !== 0}>
                    <h3>{card.title}</h3>
                    <p set:html={caption(card.description)} />
                    {card.image && <Image src={card.image} alt={card.alt ?? ""} width={720} loading="lazy" />}
                </article>
            ))
        }
    </div>
    <script is:inline data-astro-rerun>
        // Start on a random card, before the page is drawn, so the first one never flashes up first.
        {
            const cards = document.currentScript.parentElement.querySelectorAll(".card");
            const start = Math.floor(Math.random() * cards.length);
            cards.forEach((card, i) => (card.hidden = i !== start));
        }
    </script>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        for (const root of document.querySelectorAll<HTMLElement>(".why-cards")) {
            const cards = [...root.querySelectorAll<HTMLElement>(".card")];
            const button = root.querySelector<HTMLButtonElement>(".another");
            if (!button) continue;
            let current = Math.max(
                cards.findIndex((card) => !card.hidden),
                0,
            );

            // The cards not yet seen this round, in a random order. When it runs out it's refilled,
            // leaving out the card on screen so it can't come up twice in a row.
            let deck: number[] = [];
            const refill = () => {
                deck = cards.map((_, i) => i).filter((i) => i !== current);
                for (let i = deck.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [deck[i], deck[j]] = [deck[j], deck[i]];
                }
            };

            button.addEventListener("click", () => {
                if (!deck.length) refill();
                current = deck.pop()!;
                cards.forEach((card, i) => (card.hidden = i !== current));
            });
        }
    });
</script>

<style>
    .why-cards {
        display: grid;
        justify-items: start;
        gap: 14px;
        text-align: left;
    }

    /* As wide as the card's words need, up to 480px, after which they wrap. */
    .deck {
        max-width: min(480px, 100%);
    }

    /* White like the timeline's cards, with rounded corners. */
    .card {
        padding: 18px 20px 20px;
        border-radius: 22px;
        background: #fff;
        /* Each new card pops in. */
        animation: deal 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    @keyframes deal {
        from {
            opacity: 0;
            scale: 0.96;
            translate: 0 6px;
        }
    }

    h3 {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        line-height: 1.25;
        color: var(--orange);
    }

    p {
        margin: 6px 0 0;
        font-size: 16px;
        font-weight: 500;
        line-height: 1.4;
    }

    /* Links written into a description (utils/caption.ts). */
    p :global(a) {
        color: var(--orange-dark);
    }

    .card :global(img) {
        display: block;
        width: 100%;
        height: auto;
        margin-top: 14px;
        border: 3px solid var(--orange-dark);
        border-radius: 16px;
    }

    /* An orange pill, so it reads as the thing to press. */
    .another {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px 9px 14px;
        border: 0;
        border-radius: 999px;
        background: var(--orange);
        color: #fff;
        font: inherit;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: background-color 120ms ease, scale 120ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .another svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    @media (hover: hover) and (pointer: fine) {
        .another:hover {
            background: var(--orange-dark);
        }
    }

    .another:active {
        scale: 0.96;
    }

    @media (prefers-reduced-motion: reduce) {
        .card {
            animation: none;
        }

        .another {
            transition: none;
        }
    }
</style>
