---
// The projects as a pile of blocks. Each block is a link to its project, drawn as an SVG shape.
// scripts/project-pile.ts then drops them from the top of the screen with physics.
// Without JavaScript they just sit in rows.
import "@fontsource/poppins/500.css";
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { tagColour } from "../data/tags";

interface Props {
    projects: CollectionEntry<"projects">[];
}

// Bright but soft red, green and blue for the blocks.
const fills = { red: "#ff7b7b", green: "#6fe07c", blue: "#6db5ff" };

// How rounded the corners of rectangles and triangles are, in design px.
// scripts/project-pile.ts rounds the physics outlines by the same amount (it reads --corner).
const CORNER = 8;

// Hand-drawn outlines, drawn over each block: design/shape-templates/<shape name>-outline.png, and
// <shape name>-highlight.png for highlighted projects (which otherwise get the yellow line below).
// They're the shape templates drawn over, so the same size: the shape plus SPRITE_MARGIN design px
// of space on every side, at SPRITE_SCALE image px per design px. A shape with no drawing has no outline.
const SPRITE_MARGIN = 16;
const SPRITE_SCALE = 2.5;
const sprites = import.meta.glob<{ default: ImageMetadata }>("../../design/shape-templates/*-{outline,highlight}.png", {
    eager: true,
});
const sprite = (name: string | undefined, kind: "outline" | "highlight") =>
    name ? sprites[`../../design/shape-templates/${name}-${kind}.png`]?.default : undefined;

// Highlighted projects also get sparkles all the way round, placed by sparkles() below. Draw them pointing
// straight up, with the bottom of the image the end nearest the shape, at SPRITE_SCALE image px per design px
// like the outlines. The drawings in design/sparkles/*.png (as many as you like) are the frames of an
// animation: every sparkle flips through them in turn, like a hand-drawn cartoon, starting on a random one.
const SPARKLE_SPACING = 14; // design px between sparkles, going round the edge
const SPARKLE_GAP = 6; // how far outside the edge they start, in design px
const SPARKLE_OUTLINE = 1; // thickness of the black line drawn round each sparkle, in design px
const SPARKLE_FPS = 8; // frames a second: low, so it looks drawn by hand
const SPARKLE_JITTER = 0.8; // most a frame is shifted from the sparkle's spot, each way, in design px
const sparkleImages = Object.values(
    import.meta.glob<{ default: ImageMetadata }>("../../design/sparkles/*.png", { eager: true }),
).map(({ default: img }) => ({ src: img.src, w: img.width / SPRITE_SCALE, h: img.height / SPRITE_SCALE }));

// Each frame shows for its share of the loop. Keyframe stops can't come from a CSS variable,
// so they're written here for however many drawings there are.
const frameMs = 1000 / SPARKLE_FPS;
const sparkleCycle = `${Math.round(frameMs * sparkleImages.length)}ms`;
const sparkleFrames = `@keyframes sparkle-frame { 0% { opacity: 1; } ${+(100 / sparkleImages.length).toFixed(3)}%, 100% { opacity: 0; } }`;

type Point = [number, number];

// A convex outline with every corner rounded into a circular arc of radius `r` (smaller where the
// sides are too short for it). Gives the SVG path, and the same outline as a list of points for the
// physics engine, with a few points along each curve.
function roundCorners(pts: Point[], r: number) {
    const n = pts.length;
    const unit = ([x, y]: Point): Point => {
        const l = Math.hypot(x, y);
        return [x / l, y / l];
    };
    const corners = pts.map((v, i) => {
        const prev = pts[(i + n - 1) % n];
        const next = pts[(i + 1) % n];
        const u1 = unit([prev[0] - v[0], prev[1] - v[1]]);
        const u2 = unit([next[0] - v[0], next[1] - v[1]]);
        const half = Math.acos(Math.min(1, Math.max(-1, u1[0] * u2[0] + u1[1] * u2[1]))) / 2;
        // How far along each side the curve starts; the radius follows from it.
        const d = Math.min(r / Math.tan(half), Math.hypot(prev[0] - v[0], prev[1] - v[1]) / 2, Math.hypot(next[0] - v[0], next[1] - v[1]) / 2);
        const radius = d * Math.tan(half);
        const mid = unit([u1[0] + u2[0], u1[1] + u2[1]]);
        const centreDist = radius / Math.sin(half);
        return {
            a: [v[0] + u1[0] * d, v[1] + u1[1] * d] as Point,
            b: [v[0] + u2[0] * d, v[1] + u2[1] * d] as Point,
            c: [v[0] + mid[0] * centreDist, v[1] + mid[1] * centreDist] as Point,
            radius,
        };
    });
    // Which way round the outline goes, so the arcs bend the right way.
    const turn = pts.reduce((sum, [x1, y1], i) => {
        const [x2, y2] = pts[(i + 1) % n];
        return sum + (x1 * y2 - x2 * y1);
    }, 0);
    const sweep = turn > 0 ? 1 : 0;
    const f = (p: Point) => `${+p[0].toFixed(2)} ${+p[1].toFixed(2)}`;
    let path = `M ${f(corners[0].b)}`;
    for (let i = 1; i <= n; i++) {
        const k = corners[i % n];
        path += ` L ${f(k.a)} A ${+k.radius.toFixed(2)} ${+k.radius.toFixed(2)} 0 0 ${sweep} ${f(k.b)}`;
    }
    path += " Z";

    const hull: Point[] = [];
    for (const k of corners) {
        let from = Math.atan2(k.a[1] - k.c[1], k.a[0] - k.c[0]);
        let to = Math.atan2(k.b[1] - k.c[1], k.b[0] - k.c[0]);
        let delta = to - from;
        if (delta > Math.PI) delta -= 2 * Math.PI;
        if (delta < -Math.PI) delta += 2 * Math.PI;
        for (let s = 0; s <= 4; s++) {
            const angle = from + (delta * s) / 4;
            hull.push([+(k.c[0] + k.radius * Math.cos(angle)).toFixed(2), +(k.c[1] + k.radius * Math.sin(angle)).toFixed(2)]);
        }
    }
    return { path, hull };
}

// Block outline in design px (1280-wide screen), with its size and balance point (centroid),
// which is where the physics engine holds and spins it.
function geometry(block: CollectionEntry<"projects">["data"]["block"]) {
    if (block.shape === "rect") {
        const { width: w, height: h } = block;
        const edge = roundCorners([[0, 0], [w, 0], [w, h], [0, h]], CORNER).hull;
        return { w, h, cx: w / 2, cy: h / 2, edge, outline: `<rect width="${w}" height="${h}" rx="${CORNER}" />` };
    }
    if (block.shape === "circle") {
        const r = block.size / 2;
        const edge = Array.from({ length: 72 }, (_, i): Point => [r + r * Math.cos((i / 72) * 2 * Math.PI), r + r * Math.sin((i / 72) * 2 * Math.PI)]);
        return { w: block.size, h: block.size, cx: r, cy: r, edge, outline: `<circle cx="${r}" cy="${r}" r="${r}" />` };
    }
    const minX = Math.min(...block.points.map((p) => p[0]));
    const minY = Math.min(...block.points.map((p) => p[1]));
    const pts = block.points.map(([x, y]) => [x - minX, y - minY] as Point);
    const w = Math.max(...pts.map((p) => p[0]));
    const h = Math.max(...pts.map((p) => p[1]));
    const { path, hull } = roundCorners(pts, CORNER);
    // Area-weighted centroid of the rounded outline, the same point Matter.js uses as the body's position.
    let a = 0, cx = 0, cy = 0;
    hull.forEach(([x1, y1], i) => {
        const [x2, y2] = hull[(i + 1) % hull.length];
        const cross = x1 * y2 - x2 * y1;
        a += cross;
        cx += (x1 + x2) * cross;
        cy += (y1 + y2) * cross;
    });
    a /= 2;
    cx /= 6 * a;
    cy /= 6 * a;
    return { w, h, cx, cy, points: pts, hull, edge: hull, outline: `<path d="${path}" />` };
}

// Sparkles evenly spaced round a block's edge (a list of points going round it), each pointing straight
// out from it, with a little randomness in where, which drawing, how big and how tilted.
// Seeded by the project, so they're the same every time the page loads.
function sparkles(edge: Point[], [cx, cy]: Point, seed: string) {
    if (!sparkleImages.length) return [];
    let state = [...seed].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619), 2166136261);
    const random = () => {
        state = (state + 0x6d2b79f5) | 0;
        let t = Math.imul(state ^ (state >>> 15), 1 | state);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    const sides = edge.map((a, i) => {
        const b = edge[(i + 1) % edge.length];
        return { a, b, length: Math.hypot(b[0] - a[0], b[1] - a[1]) };
    });
    const total = sides.reduce((sum, s) => sum + s.length, 0);
    const count = Math.max(3, Math.round(total / SPARKLE_SPACING));

    return Array.from({ length: count }, (_, k) => {
        // How far round the edge this one goes, then which side that lands on.
        let along = (((k + (random() - 0.5) * 0.4) / count) * total + total) % total;
        const side = sides.find((s) => (along -= s.length) <= 0) ?? sides[sides.length - 1];
        const t = 1 + along / side.length;
        const [ax, ay] = side.a;
        const [bx, by] = side.b;
        const [x, y] = [ax + (bx - ax) * t, ay + (by - ay) * t];
        // Straight out: at right angles to the side, whichever way is away from the middle.
        let [nx, ny] = [(by - ay) / side.length, -(bx - ax) / side.length];
        if (nx * (x - cx) + ny * (y - cy) < 0) [nx, ny] = [-nx, -ny];
        const first = Math.floor(random() * sparkleImages.length); // which frame it starts on
        const angle = (Math.atan2(ny, nx) * 180) / Math.PI + 90 + (random() - 0.5) * 20;
        const scale = 0.8 + random() * 0.35;
        const r = (n: number) => +n.toFixed(2);
        // Each frame sits a little off from the others, so the sparkle shifts about as it flips through them.
        const nudges = sparkleImages.map(() => [r((random() - 0.5) * 2 * SPARKLE_JITTER), r((random() - 0.5) * 2 * SPARKLE_JITTER)]);
        return { first, nudges, transform: `translate(${r(x + nx * SPARKLE_GAP)} ${r(y + ny * SPARKLE_GAP)}) rotate(${r(angle)}) scale(${r(scale)})` };
    });
}

const blocks = await Promise.all(
    Astro.props.projects.map(async (project, i) => {
        const { data } = project;
        const g = geometry(data.block);
        // Resized and compressed, except GIFs, which would lose their animation.
        const img = data.block.image;
        const image = !img
            ? undefined
            : img.format === "gif"
              ? img.src
              : // Wide enough to cover the block once cropped to its shape, at 2× for sharp screens.
                (await getImage({ src: img, width: Math.round(Math.max(g.w, (g.h * img.width) / img.height) * 2) })).src;
        const highlighted = data.block.highlight;
        // A highlighted project uses its shape's highlight drawing if there is one, else the plain outline.
        const highlightSprite = highlighted ? sprite(data.block.name, "highlight") : undefined;
        const drawing = highlightSprite ?? sprite(data.block.name, "outline");
        const outline = drawing && {
            src: (await getImage({ src: drawing, format: "webp" })).src,
            width: drawing.width / SPRITE_SCALE,
            height: drawing.height / SPRITE_SCALE,
        };
        const sparks = highlighted ? sparkles(g.edge, [g.cx, g.cy], project.id) : [];
        return {
            project,
            g,
            image,
            outline,
            sparks,
            ring: highlighted && !highlightSprite,
            clipId: `block-clip-${i}`,
            sparkleOutlineId: `sparkle-outline-${i}`,
        };
    }),
);
---

<style is:inline set:html={sparkleFrames}></style>
<div class="pile" style={`--sparkle-cycle: ${sparkleCycle}`}>
    {
        blocks.map(({ project, g, image, outline, sparks, ring, clipId, sparkleOutlineId }) => {
            const { block } = project.data;
            return (
                <a
                    class:list={["block", { highlight: block.highlight }]}
                    href={`/projects/${project.id}`}
                    aria-label={project.data.title}
                    style={`--w: ${g.w}; --h: ${g.h}; --cx: ${g.cx}; --cy: ${g.cy}; --corner: ${CORNER}; --label: ${block.labelSize}; --tilt: ${block.labelAngle}deg;`}
                    data-shape={block.shape}
                    data-fill={fills[block.colour]}
                    data-points={g.points && JSON.stringify(g.points)}
                    data-hull={g.hull && JSON.stringify(g.hull)}
                    data-title={project.data.title}
                    data-description={project.data.description}
                    data-tags={JSON.stringify(project.data.tags.map((tag) => [tag, tagColour(tag)]))}
                >
                    <svg class="shape" viewBox={`0 0 ${g.w} ${g.h}`} aria-hidden="true">
                        <defs>
                            <clipPath id={clipId} set:html={g.outline} />
                            {/* A black line round each sparkle: their shapes, grown by SPARKLE_OUTLINE and
                                filled black, with the sparkles drawn back on top. */}
                            {sparks.length > 0 && (
                                <filter id={sparkleOutlineId}>
                                    <feMorphology in="SourceAlpha" operator="dilate" radius={SPARKLE_OUTLINE} result="grown" />
                                    <feFlood flood-color="#000" />
                                    <feComposite in2="grown" operator="in" />
                                    <feMerge>
                                        <feMergeNode />
                                        <feMergeNode in="SourceGraphic" />
                                    </feMerge>
                                </filter>
                            )}
                        </defs>
                        <g clip-path={`url(#${clipId})`}>
                            <g fill={fills[block.colour]} set:html={g.outline} />
                            {image && (
                                <image class="preview" href={image} width={g.w} height={g.h} preserveAspectRatio="xMidYMid slice" />
                            )}
                            {/* A faint white wash over the picture while it shows. */}
                            {image && <g class="veil" set:html={g.outline} />}
                            {/* Highlighted: a solid outline along the edge, over the picture too. Only its
                                inner half shows (it's inside the clip), so it sits just within the shape. */}
                            {ring && <g class="ring" set:html={g.outline} />}
                        </g>
                        {/* Outside the clip, so lines that wobble past the edge still show. */}
                        {outline && (
                            <image
                                class="drawing"
                                href={outline.src}
                                x={-SPRITE_MARGIN}
                                y={-SPRITE_MARGIN}
                                width={outline.width}
                                height={outline.height}
                            />
                        )}
                        {sparks.length > 0 && (
                            <g class="sparkles" filter={`url(#${sparkleOutlineId})`}>
                                {/* Every frame of the sparkle, stacked; only one shows at a time. Each frame's delay
                                    puts it at its turn in the loop, counting from the sparkle's first frame. */}
                                {sparks.map(({ first, nudges, transform }) => (
                                    <g transform={transform}>
                                        {sparkleImages.map((img, f) => (
                                            <image
                                                class:list={["sparkle", { first: f === first }]}
                                                href={img.src}
                                                x={-img.w / 2 + nudges[f][0]}
                                                y={-img.h + nudges[f][1]}
                                                width={img.w}
                                                height={img.h}
                                                style={`animation-delay: ${-Math.round(((first - f + sparkleImages.length) % sparkleImages.length) * frameMs)}ms`}
                                            />
                                        ))}
                                    </g>
                                ))}
                            </g>
                        )}
                    </svg>
                    <span class="label">{block.label ?? project.data.title}</span>
                </a>
            );
        })
    }

    <div class="card" hidden aria-hidden="true">
        <p class="card-title"></p>
        <ul class="card-tags"></ul>
        <p class="card-description"></p>
    </div>
</div>

<script>
    import { startPile } from "../scripts/project-pile";

    document.addEventListener("astro:page-load", () => {
        const root = document.querySelector<HTMLElement>(".pile");
        if (!root) return;
        const stop = startPile(root);
        document.addEventListener("astro:before-swap", stop, { once: true });
    });
</script>

<style>
    /* Without JavaScript: blocks in rows. --s scales design px to the screen. */
    .pile {
        --s: 0.6;
        /* The outline of highlighted projects. */
        --highlight: #ffe600;
        position: relative;
        min-height: 100dvh;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: center;
        gap: 16px;
        padding: 120px 16px 16px;
        overflow: hidden;
    }

    /* Only the shape itself takes the pointer (hover, clicks), not the box around it,
       so a click just outside a circle or triangle goes to whatever is behind. */
    .block {
        position: relative;
        flex: none;
        width: calc(var(--w) * var(--s) * 1px);
        height: calc(var(--h) * var(--s) * 1px);
        color: #000;
        text-decoration: none;
        pointer-events: none;
        -webkit-tap-highlight-color: transparent;
    }

    .block svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .shape > g {
        pointer-events: visiblePainted;
    }

    .shape > .sparkles {
        pointer-events: none;
    }

    /* A sparkle's frames take turns showing (sparkle-frame is written out in the frontmatter).
       steps(1): each one snaps on and off, with no fading in between. */
    .sparkle {
        opacity: 0;
        animation: sparkle-frame var(--sparkle-cycle) steps(1) infinite;
    }

    /* With only one drawing there's nothing to flip through. */
    .sparkle.first:only-child {
        opacity: 1;
        animation: none;
    }

    /* Highlighted projects: a bright yellow edge. 6 units wide, of which the inner 3 show:
       a thin solid line in design px, scaling with the block. */
    .ring {
        fill: none;
        stroke: var(--highlight);
        stroke-width: 6;
        pointer-events: none;
    }

    .label {
        position: absolute;
        left: calc(var(--cx) / var(--w) * 100%);
        top: calc(var(--cy) / var(--h) * 100%);
        width: max-content;
        max-width: calc(var(--w) * 0.78 * var(--s) * 1px);
        translate: -50% -50%;
        rotate: var(--tilt);
        font-weight: 500;
        font-size: calc(var(--label) * var(--s) * 1px);
        line-height: 1.2;
        text-align: center;
        pointer-events: none;
    }

    /* A project's image shows only while its block is hovered, fading in over the colour and label. */
    .preview,
    .veil {
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .veil {
        fill: #fff;
        pointer-events: none;
    }

    .label {
        transition: opacity 0.2s ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .block:hover .preview {
            opacity: 1;
        }

        .block:hover .veil {
            opacity: 0.2;
        }

        .block:hover:has(.preview) .label {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .preview,
        .veil,
        .label {
            transition: none;
        }

        /* Each sparkle stays on its first frame. */
        .sparkle {
            animation: none;
        }

        .sparkle.first {
            opacity: 1;
        }
    }

    /* Animations off in the settings (global.css stops the frames flipping): each sparkle shows its first frame. */
    :global(html[data-motion="off"]) .sparkle.first {
        opacity: 1;
    }

    /* With physics: the script places every block itself. */
    .pile:global(.live) {
        display: block;
        height: 100dvh;
        padding: 0;
    }

    .pile:global(.live) .block {
        position: absolute;
        left: 0;
        top: 0;
        transform-origin: calc(var(--cx) * var(--s) * 1px) calc(var(--cy) * var(--s) * 1px);
        visibility: hidden;
        will-change: transform;
    }

    .pile:global(.live) .block:global(.dropped) {
        visibility: visible;
    }

    /* Hover card, as in the design: dark box with title, tags and description. Follows the pointer. */
    .card {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 10;
        width: max-content;
        max-width: 260px;
        padding: 6px 10px 9px;
        /* Catppuccin Mocha: Base, with a Crust border. */
        background: #1e1e2e;
        border: 6px solid #11111b;
        border-radius: 4px;
        color: #cdd6f4;
        font-family: "Poppins", var(--font-body);
        font-weight: 500;
        pointer-events: none;
    }

    .card[hidden] {
        display: none;
    }

    .card-title {
        margin: 0;
        font-size: 20px;
        line-height: 1.3;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin: 2px 0 4px;
        padding: 0;
        list-style: none;
    }

    .card-tags:empty {
        display: none;
    }

    .card-tags :global(li) {
        padding: 0 6px;
        border: 1px solid #11111b;
        border-radius: 10px;
        color: #1e1e2e;
        font-size: 15px;
        line-height: 18px;
    }

    .card-description {
        margin: 0;
        color: #bac2de;
        font-size: 15px;
        line-height: 1.35;
    }
</style>
