---
// The "dubbyy" wordmark. Each letter (g.letter-N) bobs on its own and jumps when hovered.
// With links on (the home page), the d goes to the projects page and the last, darker y drops
// and links to /y. Turn them off when the whole logo is itself a link.
// The invisible .hit rect stays still so the hover doesn't flicker as the letter moves.
// animated={false} turns off the idle bobbing (hover jumps still work), e.g. for the small corner logo.
interface Props {
    class?: string;
    links?: boolean;
    animated?: boolean;
}
const { class: className, links = true, animated = true } = Astro.props;
const Link = links ? "a" : "g";
