<style>
    .logo {
        width: 100%;
        height: auto;
        overflow: visible;
    }

    /* Lengths are in the logo's own units (599 wide). Small idle animations stay on under reduced motion. */
    .hit {
        fill: transparent;
    }

    .shape {
        animation: wave 3s ease-in-out infinite backwards;
        transition: transform 1s, fill 0.1s;
    }

    .letter:hover .shape {
        transform: translateY(-27px);
        transition: transform 0.25s, fill 0.1s;
    }

    .letter-6 .shape {
        animation-name: wave-y;
    }

    .letter-6:hover .shape {
        transform: translateY(27px);
        fill: #994d00;
    }

    .letter-2 .shape { animation-delay: 0.15s; }
    .letter-3 .shape { animation-delay: 0.3s; }
    .letter-4 .shape { animation-delay: 0.45s; }
    .letter-5 .shape { animation-delay: 0.6s; }
    .letter-6 .shape { animation-delay: 0.75s; }

    @keyframes wave {
        0%, 100% { translate: 0 6.6px; }
        50% { translate: 0 -6.6px; }
    }

    @keyframes wave-y {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 4.5px; }
    }

    .still .shape {
        animation: none;
    }

    .secret:focus-visible {
        outline: none;
    }

    .secret:focus-visible .shape {
        fill: #994d00;
    }
</style>
