---
// A world map with a pin for each place in data/places.ts. Picking a pin shows that place's card under the map.
// The map is drawn when the site is built (world outlines from world-atlas), so the page just gets a picture.
import { Image } from "astro:assets";
import { geoMercator, geoPath } from "d3-geo";
import { merge, mesh } from "topojson-client";
import type { GeometryCollection, MultiPolygon, Polygon, Topology } from "topojson-specification";
import world from "world-atlas/countries-110m.json";
import { places } from "../data/places";
import { caption } from "../utils/caption";

// Every country but Antarctica, which is below the bottom of the map anyway.
type Country = Polygon<{ name: string }> | MultiPolygon<{ name: string }>;
const topology = world as unknown as Topology;
const all = topology.objects.countries as GeometryCollection<{ name: string }>;
const kept = (all.geometries as Country[]).filter((country) => country.properties?.name !== "Antarctica");
const countries: GeometryCollection<{ name: string }> = { ...all, geometries: kept };
const land = merge(topology, kept);
const borders = mesh(topology, countries, (a, b) => a !== b);

// Mercator, 960 wide, cut off at these latitudes: it stretches things more and more towards the poles,
// so the far north and south would make the map very tall. 84°N is just past the most northern land
// (the tip of Greenland). Places beyond them fall off the map.
const WIDTH = 960;
const NORTH = 84;
const SOUTH = -56;
const projection = geoMercator()
    .scale(WIDTH / (2 * Math.PI))
    .translate([WIDTH / 2, 0]);
const top = projection([0, NORTH])![1];
const height = Math.ceil(projection([0, SOUTH])![1] - top);
projection.translate([WIDTH / 2, -top]).clipExtent([
    [0, 0],
    [WIDTH, height],
]);
const path = geoPath(projection).digits(1);

// Each pin's spot, as a percentage of the map so it stays put as the map scales.
const pins = places.map((place) => {
    const [x, y] = projection([place.coords[1], place.coords[0]]) ?? [0, 0];
    return { name: place.name, left: (x / WIDTH) * 100, top: (y / height) * 100 };
});

// The ‹ › arrows: the same L shape as the screen arrows (components/ScreenArrows.astro), rotated, as on /me.
const arrow =
    "M0 62.468V4C0 1.79086 1.79086 0 4 0H21.4558C23.665 0 25.4558 1.79086 25.4558 4V35.8808C25.4558 38.09 27.2467 39.8808 29.4559 39.8808H59.6396C61.8488 39.8808 63.6396 41.6717 63.6396 43.8808V62.468C63.6396 64.6772 61.8488 66.468 59.6396 66.468H4C1.79086 66.468 0 64.6772 0 62.468Z";
---

<div class="world-map">
    <div class="map" style={`aspect-ratio: ${WIDTH} / ${height}`}>
        <svg viewBox={`0 0 ${WIDTH} ${height}`} aria-hidden="true">
            <path class="land" d={path(land)} />
            <path class="borders" d={path(borders)} />
        </svg>
        {
            pins.map((pin, i) => (
                <button
                    class="pin"
                    type="button"
                    style={`left: ${pin.left.toFixed(2)}%; top: ${pin.top.toFixed(2)}%`}
                    aria-label={pin.name}
                    aria-pressed={i === 0 ? "true" : "false"}
                />
            ))
        }
    </div>
    {/* The place's name between ‹ › buttons that step through the places, for ones whose pins are hard to hit. */}
    <div class="head">
        <button class="step prev" type="button" aria-label="Previous place">
            <svg viewBox="0 0 63.6396 66.468" aria-hidden="true"><path d={arrow} /></svg>
        </button>
        {
            places.map((place, i) => (
                <span class="pill" hidden={i !== 0}>
                    {place.name}
                </span>
            ))
        }
        <button class="step next" type="button" aria-label="Next place">
            <svg viewBox="0 0 63.6396 66.468" aria-hidden="true"><path d={arrow} /></svg>
        </button>
    </div>
    {
        places.map((place, i) => (
            <div class="place" hidden={i !== 0}>
                <p set:html={caption(place.caption)} />
                {place.image && <Image src={place.image} alt={place.alt ?? ""} width={720} loading="lazy" />}
            </div>
        ))
    }
</div>

<script>
    import { collect } from "../scripts/achievements";

    // Picking a pin (or stepping with ‹ ›) shows its place's name and card (they're all in the same order).
    // Each place's card seen counts towards the "visit every location" achievement (data/achievements.ts).
    // Some pins sit nearly on top of each other (Dublin and Delphi), so the pointer doesn't go by which pin's
    // tap area is on top: a click or tap on the map picks the pin whose middle is nearest, if one is close
    // enough, and hovering lights up that same pin. The keyboard still uses the pins themselves.
    const REACH = 20; // px from a pin's middle that still counts as pointing at it

    document.addEventListener("astro:page-load", () => {
        for (const root of document.querySelectorAll<HTMLElement>(".world-map")) {
            const map = root.querySelector<HTMLElement>(".map")!;
            const pins = [...root.querySelectorAll<HTMLButtonElement>(".pin")];
            const pills = [...root.querySelectorAll<HTMLElement>(".head .pill")];
            const cards = [...root.querySelectorAll<HTMLElement>(".place")];
            const names = pins.map((pin) => pin.getAttribute("aria-label")!);
            const visit = (i: number) => collect("all-places", names[i], names);
            let current = 0;
            const choose = (i: number) => {
                current = (i + pins.length) % pins.length;
                pins.forEach((p, j) => p.setAttribute("aria-pressed", String(j === current)));
                pills.forEach((pill, j) => (pill.hidden = j !== current));
                cards.forEach((card, j) => (card.hidden = j !== current));
                visit(current);
            };

            // The pin nearest a point on the screen, if one's within REACH.
            const nearest = (x: number, y: number) => {
                let best = -1;
                let bestDistance = REACH;
                pins.forEach((pin, i) => {
                    const box = pin.getBoundingClientRect();
                    const d = Math.hypot(x - (box.left + box.width / 2), y - (box.top + box.height / 2));
                    if (d <= bestDistance) {
                        best = i;
                        bestDistance = d;
                    }
                });
                return best;
            };
            const near = (i: number) => {
                pins.forEach((p, j) => p.classList.toggle("near", j === i));
                map.classList.toggle("pointing", i >= 0);
            };

            map.addEventListener("click", (e) => {
                // A pin "clicked" from the keyboard (Enter or Space) has no pointer position: that pin it is.
                const pin = (e.target as Element).closest<HTMLButtonElement>(".pin");
                if (pin && e.detail === 0) return choose(pins.indexOf(pin));
                const i = nearest(e.clientX, e.clientY);
                if (i >= 0) choose(i);
            });
            map.addEventListener("pointermove", (e) => near(e.pointerType === "mouse" ? nearest(e.clientX, e.clientY) : -1));
            map.addEventListener("pointerleave", () => near(-1));

            root.querySelector(".prev")!.addEventListener("click", () => choose(current - 1));
            root.querySelector(".next")!.addEventListener("click", () => choose(current + 1));
            // The place already showing counts once the map is actually on screen (it can be on a hidden tab).
            const seen = new IntersectionObserver((entries) => {
                if (!entries.some((e) => e.isIntersecting)) return;
                visit(current);
                seen.disconnect();
            });
            seen.observe(map);
            document.addEventListener("astro:before-swap", () => seen.disconnect(), { once: true });
        }
    });
</script>

<style>
    .world-map {
        text-align: left;
    }

    .map {
        position: relative;
        width: 100%;
    }

    svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .land {
        fill: #ffdcb8;
    }

    .borders {
        fill: none;
        stroke: var(--bg);
        stroke-width: 0.8;
        stroke-linejoin: round;
    }

    /* Orange dots with a white ring; the picked one is darker and bigger. */
    .pin {
        position: absolute;
        width: 14px;
        height: 14px;
        padding: 0;
        border: 3px solid #fff;
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 1px 3px rgb(26 13 0 / 0.25);
        translate: -50% -50%;
        /* Clicks and hovers are worked out from the map (the nearest pin wins: see the script). */
        pointer-events: none;
        transition: scale 150ms cubic-bezier(0.23, 1, 0.32, 1), background-color 120ms ease;
    }

    .map.pointing {
        cursor: pointer;
    }

    .pin[aria-pressed="true"] {
        z-index: 1;
        background: var(--orange-dark);
        scale: 1.35;
    }

    /* The pin a click would pick right now. */
    .pin.near {
        z-index: 2;
        scale: 1.25;
    }

    .pin[aria-pressed="true"].near {
        scale: 1.35;
    }

    /* ‹ the place's name › */
    .head {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 16px;
    }

    .head .pill[hidden] {
        display: none;
    }

    /* Like the question arrows on the about page. */
    .step {
        flex: none;
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 0;
        background: none;
        color: var(--orange-dark);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: color 120ms ease, scale 120ms cubic-bezier(0.23, 1, 0.32, 1), translate 120ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .step svg {
        width: 60%;
        overflow: visible;
        fill: currentColor;
    }

    .prev svg {
        rotate: 45deg;
    }

    .next svg {
        rotate: -135deg;
    }

    @media (hover: hover) and (pointer: fine) {
        .step:hover {
            color: var(--orange);
            scale: 1.1;
        }
    }

    /* Pressed: nudge the way it points. */
    .prev:active {
        scale: 0.9;
        translate: -2px 0;
    }

    .next:active {
        scale: 0.9;
        translate: 2px 0;
    }

    .place {
        margin-top: 8px;
        animation: place-in 180ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* Named apart from the about page's own "rise", since animation names are shared across the page. */
    @keyframes place-in {
        from {
            opacity: 0;
            translate: 0 8px;
        }
    }

    /* The same white, fully rounded cards as the timeline. */
    .pill {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 999px;
        background: #fff;
        color: var(--orange);
        font-weight: 800;
        font-size: 17px;
        line-height: 1.3;
    }

    p {
        margin: 0;
        font-size: 16px;
        font-weight: 500;
        line-height: 1.4;
    }

    /* Links written into a caption (utils/caption.ts). */
    p :global(a) {
        color: var(--orange-dark);
    }

    .place :global(img) {
        display: block;
        width: 100%;
        max-width: 360px;
        height: auto;
        margin-top: 12px;
        border: 3px solid var(--orange-dark);
        border-radius: 16px;
    }

    @media (prefers-reduced-motion: reduce) {
        .pin,
        .step {
            transition: none;
        }

        .place {
            animation: none;
        }
    }
</style>
